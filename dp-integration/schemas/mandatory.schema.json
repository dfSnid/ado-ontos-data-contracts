{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mandatory-fields",
  "title": "Mandatory data contract fields (overlay on ODCS 3.1.0)",
  "type": "object",
  "required": ["id", "name", "domain", "status", "version", "team", "schema", "customProperties"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "name": {"type": "string", "minLength": 1},
    "domain": {"type": "string", "enum": ["sales"]},
    "status": {"type": "string", "enum": ["draft", "proposed", "under_review", "approved", "active", "deprecated", "retired"]},
    "team": {
      "type": "object",
      "required": ["members"],
      "properties": {
        "members": {
          "type": "array",
          "allOf": [
            {"contains": {"required": ["username", "role"], "properties": {"role": {"const": "Business Data Owner"}, "username": {"minLength": 1}}},
             "errorMessage": "a named Business Data Owner"},
            {"contains": {"required": ["username", "role"], "properties": {"role": {"const": "Data Steward"}, "username": {"minLength": 1}}},
             "errorMessage": "a named Data Steward"}
          ]
        }
      }
    },
    "schema": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "object", "required": ["properties"], "properties": {"properties": {"type": "array", "minItems": 1}}}
    },
    "customProperties": {
      "type": "array",
      "allOf": [
        {"contains": {"required": ["property", "value"], "properties": {"property": {"const": "governanceTier"}, "value": {"enum": [1, 2]}}},
         "errorMessage": "governanceTier (1 or 2)"},
        {"contains": {"required": ["property", "value"], "properties": {"property": {"const": "securityClassification"}, "value": {"enum": ["public", "internal", "confidential", "restricted"]}}},
         "errorMessage": "securityClassification (public, internal, confidential or restricted)"},
        {"contains": {"required": ["property", "value"], "properties": {"property": {"const": "containsPii"}, "value": {"type": "boolean"}}},
         "errorMessage": "containsPii (true or false)"}
      ]
    }
  }
}
