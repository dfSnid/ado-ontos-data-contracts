# {{contract_name}}: data contract for the {{product_name}} data product, built by the
# {{bundle}} bundle. Generated by `dpi new-product`: replace every <placeholder>, then describe
# the real columns. Each object here is one dataset the bundle's pipeline builds.
# The status moves with the gates: draft (G1), proposed (G2), approved (G3, objects may not exist
# yet), active (G4, after the bundle has built them). The {{domain}} Data Stewards approve each PR.
apiVersion: v3.1.0
kind: DataContract
id: {{contract}}
name: {{contract_name}}
version: {{version}}
status: draft
domain: {{domain}}
dataProduct: {{product}}

description:
  purpose: <What this data is for, in one sentence.>
  usage: <How to query it, and what to join it to.>
  limitations: <What it does not cover.>

# CI fails without a named Business Data Owner and Data Steward.
team:
  name: {{domain_title}}
  members:
    - username: <business-data-owner@your-org>
      role: Business Data Owner
    - username: <data-steward@your-org>
      role: Data Steward

# One server per environment. Publish only touches the environments listed here, and the bundle's
# targets use the same catalogs.
servers:
  - server: dev
    type: databricks
    environment: dev
    host: adb-0000000000000000.0.azuredatabricks.net   # your workspace host
    catalog: {{catalog_dev}}
    schema: {{schema}}
  - server: prod
    type: databricks
    environment: prod
    host: adb-0000000000000000.0.azuredatabricks.net   # your workspace host
    catalog: {{catalog_prod}}
    schema: {{schema}}

schema:
  - name: {{dataset}}
    physicalName: {{dataset}}
    physicalType: materialized_view
    logicalType: object
    businessName: <Business name>
    description: <One row per ...>
    properties:
      # Publish fails if the built object's columns differ from this list, so keep it in step
      # with the pipeline code. `required: true` becomes an IS NOT NULL expectation (warns).
      - name: id
        logicalType: string
        physicalType: STRING
        primaryKey: true
        required: true
        unique: true
        description: <Stable identifier.>
      - name: category
        logicalType: string
        physicalType: STRING
        required: true
        description: <A coded value.>
        quality:
          # Becomes the expectation `category IS NULL OR category IN ('a', 'b')`.
          # severity: warning keeps and counts the row, error drops it, critical fails the update.
          - type: library
            metric: invalidValues
            arguments:
              validValues: [a, b]
            mustBe: 0
            dimension: conformity
            severity: warning
      - name: loaded_at
        logicalType: timestamp
        physicalType: TIMESTAMP
        required: true
        description: When the row was built.
    quality:
      # A whole-table rule: datacontract test runs the count, and the `expectation` custom
      # property applies the same rule row by row in the pipeline.
      - type: sql
        name: loaded_in_the_past
        description: No row is stamped in the future.
        query: SELECT count(*) FROM ${object} WHERE loaded_at > current_timestamp()
        mustBe: 0
        dimension: consistency
        severity: warning
        customProperties:
          - property: expectation
            value: loaded_at <= current_timestamp()

slaProperties:
  - property: freshness
    value: 24
    unit: h
    description: Refreshed at least daily (advisory).

# CI fails without these three.
customProperties:
  - property: governanceTier
    value: 2           # 2 = domain: the domain's Data Stewards sign off (see tags.tier_values)
  - property: securityClassification
    value: internal    # public, internal, confidential or restricted
  - property: containsPii
    value: false
