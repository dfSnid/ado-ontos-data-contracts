# {{product_name}} data product (ODPS v1.0.0). Generated by `dpi new-product`. Registered in Ontos
# by the publish pipeline (dpi sync-products), owned by the {{domain}} domain team.
# Each output port names a contract by its id and version; the port version must match the
# contract file. Move the status with the gates: draft (G1), proposed (G2), approved (G3: port
# contracts approved), active (G4: port contracts active, objects built by {{bundle}}).
# certificationLevel and publicationScope need status active.
apiVersion: v1.0.0
kind: DataProduct
id: {{product}}
name: {{product_name}}
version: {{version}}
status: draft
domain: {{domain}}
tenant: dp-contracts
description:
  purpose: <What the product is for.>
  usage: <Where a consumer should start.>
  limitations: <What it does not cover.>
outputPorts:
  - name: {{port_name}}
    version: {{version}}
    contractId: {{contract}}
    description: <What this port offers.>
customProperties:
  - property: governanceTier
    value: 2
