# {{product_name}} data product bundle: the code that builds the objects the {{contract}}
# contract names. Generated by `dpi new-product`. Deployed by pipelines/deploy.yml (dev, then
# prod behind an approval); the data-contracts publish pipeline then applies the Unity Catalog
# metadata (tags, comments, grants, Certified badge). This bundle never sets any of that.
bundle:
  name: {{product}}

include:
  - resources/*.yml

# Git-ignored, copied in before each deploy by bin/fetch-rules.sh (dp-integration).
sync:
  include:
    - src/pipeline/contract_expectations.py
    - src/pipeline/contracts/*.odcs.yaml

variables:
  catalog:
    description: Catalog of the contract server for this target
  source_table:
    description: The table the pipeline reads
    default: <catalog>.<schema>.<source table>

workspace:
  host: https://adb-0000000000000000.0.azuredatabricks.net   # your workspace host

targets:
  # A personal copy for trying a change: a prefixed schema in the dev catalog, nothing shared.
  local:
    mode: development
    default: true
    variables:
      catalog: {{catalog_dev}}
  dev:
    variables:
      catalog: {{catalog_dev}}    # contract server dev
  prod:
    variables:
      catalog: {{catalog_prod}}    # contract server prod
