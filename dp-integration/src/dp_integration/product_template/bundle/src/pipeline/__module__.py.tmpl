"""Lakeflow pipeline: the datasets of the {{contract}} contract, with the contract's rules.

Generated by `dpi new-product`. Replace the query with the product's logic; the column names must
match the contract, or publish fails on schema drift. The rules are not written here: the deploy
copies the merged contract and contract_expectations.py (from dp-integration) next to this file,
and `rules.apply` turns the contract's row-level rules into expectations on each dataset.
"""
from pyspark import pipelines as dp

from contract_expectations import ContractExpectations

rules = ContractExpectations.from_file(spark.conf.get("contract_path"))  # noqa: F821 (pipeline global)
SOURCE = spark.conf.get("source_table")  # noqa: F821


@dp.materialized_view(name="{{dataset}}", table_properties=rules.table_properties())
@rules.apply("{{dataset}}")
def {{dataset}}():
    # TODO: the product's logic. One column per property of {{dataset}} in the contract.
    return spark.sql(f"""
        SELECT CAST(id AS STRING) AS id, CAST(category AS STRING) AS category,
               current_timestamp() AS loaded_at
        FROM {SOURCE}""")
